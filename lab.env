# Single source of truth for this lab. Edit the values marked CHANGE ME.
# Sourced by scripts; also read by Claude Code. Keep it accurate.

# ---------- Windows host ----------
VM_ROOT="D:\VMs"                       # CHANGE ME if your free space is elsewhere
ISO_PATH="D:\VMs\iso\OracleLinux-R9-U8-x86_64-dvd.iso"
SHARED_DISK_DIR="D:\VMs\shared"
VBOXMANAGE="C:\Program Files\Oracle\VirtualBox\VBoxManage.exe"

# Exact name from: VBoxManage list bridgedifs
# This is the USB gigabit Ethernet adapter, NOT Wi-Fi.
BRIDGE_ADAPTER="Killer E3100G 2.5 Gigabit Ethernet Controller"

# ---------- Network ----------
LAN_SUBNET="192.168.137.0/24"
LAN_GATEWAY="192.168.137.1"
LAN_PREFIX="24"
DNS_SERVERS="192.168.137.1 1.1.1.1"
DOMAIN="lab.local"

PRIV_NET_1="racpriv1"                  # VirtualBox internal network, RAC interconnect 1
PRIV_NET_2="racpriv2"                  # VirtualBox internal network, RAC interconnect 2

# ---------- Nodes ----------
OP_VM="ocne-op";    OP_HOST="ocne-op.lab.local";   OP_IP="192.168.137.210"
CP1_VM="ocne-cp1";  CP1_HOST="ocne-cp1.lab.local"; CP1_IP="192.168.137.211"
W1_VM="ocne-w1";    W1_HOST="ocne-w1.lab.local";   W1_IP="192.168.137.221"
W2_VM="ocne-w2";    W2_HOST="ocne-w2.lab.local";   W2_IP="192.168.137.222"

GOLDEN_VM="ol9-golden"
ALL_VMS="ocne-op ocne-cp1 ocne-w1 ocne-w2"
WORKERS="ocne-w1 ocne-w2"

# ---------- OCNE ----------
OCNE_VERSION="1.9"
OCNE_ENV_NAME="ocnelab"
OCNE_CLUSTER_NAME="ocnecluster"
MULTUS_MODULE_NAME="mymultus"
K8S_VERSION="1.29"                     # determines the cert-manager version you may use

# ---------- Kubernetes namespaces ----------
NS_OPERATOR="oracle-database-operator-system"
NS_SIDB="sidb"
NS_RAC="rac"

# ---------- Storage ----------
NFS_SERVER="ocne-op"
NFS_EXPORT_STAGE="/export/stage"
NFS_EXPORT_ORADATA="/export/oradata"
STAGE_MOUNT="/scratch/software/stage"
RAC_HOST_SW_LOCATION="/scratch/rac/cluster01"

# Shared ASM disks: fixed-size, shareable, attached to BOTH workers only.
ASM_DISK_1="asm1.vdi"   # 40 GB, SATA port 2, serial asmdisk0001, guest /dev/sdc
ASM_DISK_2="asm2.vdi"   # 40 GB, SATA port 3, serial asmdisk0002, guest /dev/sdd
ASM_DISK_3="asm3.vdi"   # 20 GB, SATA port 4, serial asmdisk0003, guest /dev/sde  (reserve)

# ---------- Oracle software ----------
ORACLE_UID="54321"
ORACLE_GID="54321"
GI_VERSION="19.28"
DB_VERSION="19.28"
GI_BASE_ZIP="LINUX.X64_193000_grid_home.zip"
DB_BASE_ZIP="LINUX.X64_193000_db_home.zip"
RU_PATCH="37957391"                    # GI Release Update 19.28.0
REC_PATCH_1="38336965"
REC_PATCH_2="34436514"
OPATCH_PATCH="6880880"

EE_IMAGE="container-registry.oracle.com/database/enterprise:19.3.0.0"
RAC_SLIM_IMAGE="dbocir/oracle/database-rac:19.3.0-slim"
PULL_SECRET_NAME="oracle-container-registry-secret"

# ---------- Worker tuning ----------
# Oracle's reference is 16384 (32 GB) on a 60 GB node. These are 20 GB nodes.
HUGEPAGES="3072"                       # 6 GB
RAC_NODE_LABEL="raccluster=raccluster01"
